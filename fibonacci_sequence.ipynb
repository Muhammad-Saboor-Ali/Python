    "def fibonacci(n):\n",
    "    a, b = 0, 1\n",
    "    for i in range(n):\n",
    "        print(a, end=\" \")\n",
    "        a, b = b, a + b  \n",
    "\n",
    "num = int(input(\"Enter the number of Fibonacci terms: \"))\n",
    "fibonacci(num)"
